# Radar Assistant — environment reference.
#
# SECRETS DO NOT LIVE HERE. Real secrets go in the macOS Keychain via the setup
# wizard (scripts/setup_wizard.py). This file documents names and non-secret config
# only. Copy to `.env` for local non-secret overrides if you like.

# Where the local dashboard listens
RADAR_HOST=127.0.0.1
RADAR_PORT=4317

# Ollama (local model service) — must be running: `ollama serve`
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_CLASSIFY_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Claude API model for drafting (key itself is in Keychain, not here)
CLAUDE_MODEL=claude-opus-4-8

# Paths
RADAR_DATA_DIR=./data
RADAR_LOG_DIR=./logs

# --- Keychain item names (values stored securely, not here) ---
# ANTHROPIC_API_KEY            -> keychain service "radar-assistant", account "anthropic_api_key"
# GOOGLE_OAUTH_CLIENT          -> keychain ... "google_oauth_client_json"
# GOOGLE_OAUTH_TOKEN           -> keychain ... "google_oauth_token_json"
# TELEGRAM_API_ID              -> keychain ... "telegram_api_id"
# TELEGRAM_API_HASH            -> keychain ... "telegram_api_hash"
# TELEGRAM_SESSION             -> keychain ... "telegram_session"
